# Gym Tracker Pro - Environment Variables

# Supabase Configuration
# Obtén estas credenciales en: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Instrucciones:
# 1. Copia este archivo a .env.local
# 2. Reemplaza los valores con tus credenciales de Supabase
# 3. Nunca commitees .env.local al repositorio
